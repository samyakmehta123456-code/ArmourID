{
  "buildCommand": "cd Frontend_app && npm run build",
  "outputDirectory": "Frontend_app/build",
  "rewrites": [
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/service-worker.js", "destination": "/service-worker.js" },
    { "source": "/icon-192.png", "destination": "/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/icon-512.png" },
    { "source": "/maskable-icon-512.png", "destination": "/maskable-icon-512.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
